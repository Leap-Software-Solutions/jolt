{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"allowJs": false,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.svelte",
		"src/**/*.svelte.ts",
		"vite.config.ts",
		"vitest.config.ts",
		".storybook/**/*.ts",
		"tests/**/*.ts"
	]
}
