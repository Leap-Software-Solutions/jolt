{
	"name": "@leap-online/jolt",
	"version": "0.5.0",
	"description": "Leap's Svelte 5 component library.",
	"author": "Leap Software Solutions",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Leap-Software-Solutions/jolt.git"
	},
	"homepage": "https://github.com/Leap-Software-Solutions/jolt#readme",
	"bugs": {
		"url": "https://github.com/Leap-Software-Solutions/jolt/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.16.1",
	"keywords": [
		"svelte",
		"component-library",
		"design-system",
		"bits-ui",
		"tailwindcss"
	],
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"!dist/**/*.stories.*",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"THIRD_PARTY_NOTICES.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles.css": "./dist/styles/theme.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "storybook dev -p 6006 --no-open",
		"build": "svelte-package",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:unit": "vitest run --project=unit",
		"test:components": "vitest run --project=components",
		"test:storybook": "vitest run --project=storybook",
		"storybook": "storybook dev -p 6006 --no-open",
		"storybook:build": "storybook build",
		"package": "svelte-package && publint",
		"package:types": "attw --pack .",
		"test:consumer": "pnpm build && node tests/consumer/verify.mjs",
		"changeset": "changeset"
	},
	"peerDependencies": {
		"bits-ui": "^2.20.0",
		"svelte": "^5.33.0",
		"tailwindcss": "^4.0.0"
	},
	"peerDependenciesMeta": {},
	"dependencies": {
		"@fontsource-variable/manrope": "^5.3.0",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.70.0",
		"@tanstack/svelte-table": "^9.3.1",
		"clsx": "^2.1.1",
		"highlight.js": "11.12.0",
		"marked": "18.2.0",
		"sanitize-html": "2.18.2",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.1",
		"tw-animate-css": "^1.4.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@changesets/cli": "3.0.3",
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@storybook/addon-a11y": "10.6.6",
		"@storybook/addon-docs": "10.6.6",
		"@storybook/addon-svelte-csf": "5.1.6",
		"@storybook/addon-themes": "10.6.6",
		"@storybook/addon-vitest": "10.6.6",
		"@storybook/svelte-vite": "10.6.6",
		"@sveltejs/package": "3.0.2",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "26.6.6",
		"@types/sanitize-html": "2.16.2",
		"@vitest/browser-playwright": "5.1.0",
		"bits-ui": "2.20.6",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-import-x": "4.18.1",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"eslint-plugin-storybook": "10.6.6",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"playwright": "1.65.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"publint": "0.3.25",
		"storybook": "10.6.6",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.7",
		"vitest": "5.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
